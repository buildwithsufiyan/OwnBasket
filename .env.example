# Runtime mode (copy to an untracked .env only if your process manager loads it)
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
SITE_NAME=OwnBasket
SITE_DOMAIN=shop.example.com
CANONICAL_BASE_URL=https://shop.example.com

# PostgreSQL recommended in production; local development defaults to SQLite.
DATABASE_URL=postgresql://ownbasket_user:replace-me@db.example.com:5432/ownbasket
DB_CONN_MAX_AGE=60
CACHE_URL=redis://redis.example.com:6379/1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OwnBasket <noreply@example.com>

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
TRUST_PROXY_SSL_HEADER=true
CSP_REPORT_ONLY=true
RATE_LIMIT_ENABLED=true

# Persistent volume/object storage path and optional rotating log file.
MEDIA_ROOT=/srv/ownbasket/media
DJANGO_LOG_FILE=/srv/ownbasket/logs/django.log
LOG_LEVEL=INFO

# Configure only the provider actually used by the deployment.
STRIPE_PUBLIC_KEY=replace-me
STRIPE_SECRET_KEY=replace-me
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
